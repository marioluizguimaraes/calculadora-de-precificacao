# Copie para .env.local e ajuste. Apenas variáveis com prefixo VITE_ chegam ao navegador:
# nunca coloque segredos aqui.

VITE_APP_NAME="Claquete"
VITE_DEV_PORT=5173

# Localidades (estados, mesorregiões, municípios) — API pública do IBGE
VITE_IBGE_API_URL=https://servicodados.ibge.gov.br/api/v1/localidades

# Coordenadas dos municípios (dataset aberto, código IBGE → lat/long)
VITE_MUNICIPALITIES_COORDS_URL=https://raw.githubusercontent.com/kelvins/municipios-brasileiros/main/json/municipios.json

# Rotas rodoviárias (OSRM — servidor público de demonstração)
VITE_ROUTING_API_URL=https://router.project-osrm.org

# Formatação monetária
VITE_DEFAULT_LOCALE=pt-BR
VITE_DEFAULT_CURRENCY=BRL

# Chave usada para persistir o rascunho do orçamento no localStorage
VITE_STORAGE_KEY=calc-precificacao:v1

# API do sistema (contas, orçamentos salvos, marketplace e chat).
# Deixe vazio para usar os dados simulados de src/features/*/mocks (salvos no localStorage).
VITE_API_URL=
